# ==============================================================================
# Autonomous Outbound Lead Generation Pipeline - Environment Configuration
# ==============================================================================

# Application Environment (production, development, test)
APP_ENV=production

# Server Network Binding (Loopback only for reverse proxy security)
HOST=127.0.0.1
PORT=8000

# Database Connection (SQLite WAL outside public web root)
DATABASE_URL=sqlite:///./data/outbound.db

# Cryptographic Authentication (Generate with: openssl rand -hex 32)
# REQUIRED: Cannot be left blank
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURE_COOKIES=

# Cross-Origin Resource Sharing (Comma-separated origins)
CORS_ORIGINS=https://work.raghavpatak.me,https://work.raghavpathak.me

# ------------------------------------------------------------------------------
# Authoritative Delivery Safety Configuration
# NON-NEGOTIABLE: Live sending requires ALL THREE:
#   DELIVERY_MODE=live
#   DRY_RUN=false
#   CONFIRM_LIVE=true
# Default deployment baseline is always non-live staging:
# ------------------------------------------------------------------------------
DELIVERY_MODE=stage
DRY_RUN=true
CONFIRM_LIVE=false

# Volume Caps (Rolling safety limits)
MAX_SENDS_PER_DAY=10
MAX_SENDS_PER_WEEK=50

# Pipeline Model & Adapter Modes
DISCOVERY_MODE=research
ENRICHMENT_MODE=two_stage
DRAFTING_MODE=live
COMPANY_SIZE=any

# Free Tier Gemini Models (Zero Pro models)
GEMINI_DISCOVERY_MODEL=gemini-3.6-flash
GEMINI_DRAFTING_MODEL=gemini-3.6-flash
GEMINI_PERSON_RESEARCH_MODEL=gemini-3.6-flash
GEMINI_CALL_DELAY_MS=2000

# Confidence & Deliverability Thresholds
MIN_EMAIL_CONFIDENCE=80
MIN_PERSON_CONFIDENCE=0.70
ALLOW_ACCEPT_ALL=false

# Provider API Keys (Leave blank if running in stub mode)
GEMINI_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
INSTANTLY_API_KEY=
LEMLIST_API_KEY=
PHANTOMBUSTER_API_KEY=

# Delays & Pacing
ENRICHMENT_DELAY_MS=0
DELIVERY_DELAY_MS=0
